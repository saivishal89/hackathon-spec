# ==========================================
# SLA AI Platform - Environment Configuration
# ==========================================

# Application Environment
NODE_ENV=production
ENVIRONMENT=production
PORT=5000
API_PORT=8000

# Supabase Auth & Database (Google & GitHub OAuth)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend & Database
DATABASE_URL=postgresql://sla_user:sla_secure_password_2026@postgres:5432/sla_ai_db
REDIS_URL=redis://redis:6379/0

# Security & Authentication
JWT_SECRET_KEY=sla_ai_super_secret_jwt_key_2026_enterprise_production_grade
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Configuration (Optional: defaults to intelligent tiered heuristic engine)
OPENAI_API_KEY=
AI_RISK_THRESHOLD=60.0
AI_COST_OPTIMIZED_MODE=true

# CORS
CORS_ORIGINS=["http://localhost:5000","http://localhost:3000","http://localhost:80","http://localhost"]
